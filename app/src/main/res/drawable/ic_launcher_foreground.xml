<?xml version="1.0" encoding="utf-8"?>
<!-- 图标前景：后方葡萄气泡（含白色小鱼）+ 前方猫脸气泡。
     投影在 VectorDrawable 里做不了模糊，靠猫的粗描边维持层次。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- SVG 里是 translate(49,51) scale(1.13) translate(-54,-54)，这里等价换成 scale + 位移 -->
    <group
        android:scaleX="1.13"
        android:scaleY="1.13"
        android:pivotX="0"
        android:pivotY="0"
        android:translateX="-12.02"
        android:translateY="-10.02">

        <!-- 气泡尾巴 -->
        <path
            android:pathData="M23,66 L17.4,78.6 Q15.8,82.4 20.2,80.6 L33,73.4 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="17" android:startY="66"
                    android:endX="34" android:endY="84">
                    <item android:offset="0" android:color="#FF8E7BE8" />
                    <item android:offset="1" android:color="#FF6E58D6" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 后方圆气泡 -->
        <path
            android:pathData="M34,10 C52,10 66,24 66,42 C66,52 62,60 55,66 C50,70.6 44,73 37,73 C28,73 21,69 17,62 C14,57 13,52 13,45 C13,25 20,10 34,10 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="13" android:startY="10"
                    android:endX="66" android:endY="73">
                    <item android:offset="0" android:color="#FF8E7BE8" />
                    <item android:offset="1" android:color="#FF6E58D6" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 白色小鱼：身子 + 尾巴 -->
        <path
            android:pathData="M30,40 C30,34 36.4,29.4 44,29.4 C51.6,29.4 57,34.6 57,40 C57,45.4 51.6,50 44,50 C36.4,50 30,45.6 30,40 Z M31,40 L21.6,33.4 Q19.4,32 19.6,35.4 L19.6,44.6 Q19.4,48 21.6,46.6 Z"
            android:fillColor="#FFF4FBFF"
            android:fillType="evenOdd" />

        <path
            android:pathData="M49.5,35.3 a2.3,2.3 0 1,0 0,4.6 a2.3,2.3 0 1,0 0,-4.6 Z"
            android:fillColor="#FF2E2A44" />

        <!-- 前方猫脸气泡 -->
        <path
            android:pathData="M51,66 L61,41 L71,57 L85,39 L93,63 C101,68 105,75 101,80 C99.4,82.4 96.4,83.6 93.6,83.6 C97,88 99,94 94,99 C88,105 79,106 70,106 C58,106 50,99 47,89 C44,79 45,71 51,66 Z"
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FF2E2A44"
            android:strokeWidth="4.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- 笑眼 + 小嘴 -->
        <path
            android:pathData="M60.5,72.5 Q65,65.8 69.5,72.5"
            android:strokeColor="#FF2E2A44"
            android:strokeWidth="3.7"
            android:strokeLineCap="round" />
        <path
            android:pathData="M82,70.6 Q86.5,63.9 91,70.6"
            android:strokeColor="#FF2E2A44"
            android:strokeWidth="3.7"
            android:strokeLineCap="round" />
        <path
            android:pathData="M72.6,82.4 Q76.4,86.6 80.2,82.4"
            android:strokeColor="#FF2E2A44"
            android:strokeWidth="2.9"
            android:strokeLineCap="round" />
    </group>
</vector>
